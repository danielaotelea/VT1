OPENAI_API_KEY=sk-...

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level for all backends (DEBUG, INFO, WARNING, ERROR). Defaults to INFO.
# LOG_LEVEL=DEBUG

# ── Langfuse (local Docker Compose on port 3000) ──────────────────────────────
# Create one Langfuse project per agent in the UI — each project gets its own
# public + secret key pair.
# LANGFUSE_HOST=http://localhost:3000
#
# Simple agent project:
# LANGFUSE_PUBLIC_KEY_SIMPLE_AGENT=pk-lf-...
# LANGFUSE_SECRET_KEY_SIMPLE_AGENT=sk-lf-...
#
# Multi-agent (v1) project:
# LANGFUSE_PUBLIC_KEY_MULTI_AGENT=pk-lf-...
# LANGFUSE_SECRET_KEY_MULTI_AGENT=sk-lf-...
#
# A2A multi-agent (v2) project:
# LANGFUSE_PUBLIC_KEY_A2A=pk-lf-...
# LANGFUSE_SECRET_KEY_A2A=sk-lf-...

# ── Arize Phoenix (local Docker Compose on port 6006) ────────────────────────
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# Per-agent Phoenix project names (each agent gets its own project in the UI)
# PHOENIX_PROJECT_NAME_SIMPLE_AGENT=vt1-simple-agent
# PHOENIX_PROJECT_NAME_MULTI_AGENT=vt1-multi-agent
# PHOENIX_PROJECT_NAME_A2A=vt1-a2a

# ── Comet Opik (local Docker Compose on port 5173) ───────────────────────────
# OPIK_URL_OVERRIDE=http://localhost:5173/api

# Per-agent Opik project names (each agent gets its own project in the UI)
# OPIK_PROJECT_NAME_SIMPLE_AGENT=vt1-simple-agent
# OPIK_PROJECT_NAME_MULTI_AGENT=vt1-multi-agent
# OPIK_PROJECT_NAME_A2A=vt1-a2a

# ── A2A service URLs (only needed when running multi_agent_a2a) ───────────────
# RESEARCHER_URL=http://127.0.0.1:8011
# EVALUATOR_URL=http://127.0.0.1:8012
#
# Exporter for Researcher and Evaluator services (set before starting them).
# Must match what you select in the orchestrator UI for cross-service traces.
# EXPORTER_A2A=phoenix

# ── ResearcherAgent web search (pick one) ────────────────────────────────────
# TAVILY_API_KEY=...
# (DuckDuckGo is used as fallback when TAVILY_API_KEY is not set — no key needed)
